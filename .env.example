# Variables de entorno - Convivo Discovery Server (copiar a .env, nunca versionar .env)

# Credenciales HTTP Basic del dashboard/API Eureka (obligatorias, sin defaults)
EUREKA_USERNAME=
EUREKA_PASSWORD=

# Keystore TLS montado en runtime desde ./certs/keystore.p12, nunca en el repo. Generar con:
# keytool -genkeypair -alias discovery-server -keyalg RSA -keysize 3072 -validity 365 -storetype PKCS12 \
#   -keystore certs/keystore.p12 -dname "CN=localhost" -ext "SAN=dns:localhost,dns:discovery-server,ip:127.0.0.1"
SSL_KEYSTORE_PASSWORD=

# Token de SonarQube (servicio scanner, perfil tools)
SONAR_TOKEN=
